# PhishShield AI API server. Copy to .env and fill in what you have; every key is optional.
# The server runs (and says so in /v1/health) with any subset configured.

# Bind address. Keep 127.0.0.1 unless you deploy behind HTTPS.
HOST=127.0.0.1
PORT=8787

# Comma-separated extension origins allowed to call the API, e.g. chrome-extension://<your-extension-id>.
# Empty = any chrome-extension:// or moz-extension:// origin (fine for local development only).
ALLOWED_ORIGINS=

# Google Safe Browsing Lookup API v4 key (Google Cloud console → enable "Safe Browsing API").
# Non-commercial use only; commercial products must use Google Web Risk instead.
GSB_API_KEY=

# OpenPhish community feed (free, non-commercial, refreshed every 12 hours). Enabled by default.
OPENPHISH_ENABLED=true
# Optional: use the GitHub mirror instead (only the two official feed URLs are accepted).
# OPENPHISH_FEED_URL=https://raw.githubusercontent.com/openphish/public_feed/refs/heads/main/feed.txt

# VirusTotal API v3 key (free "Public API" key from your VirusTotal account page). Optional.
# Used ON DEMAND only: links you scan by hand and SHA-256 fingerprints of files you scan in the
# Security Center. Files are never uploaded. Public API: 4 lookups/min, 500/day, non-commercial use only.
VT_API_KEY=

# Domain age via RDAP (official domain registries, found through the IANA bootstrap file). No key.
# Only the registrable domain (e.g. example.co.in) is sent, never the full URL.
RDAP_ENABLED=true

# Have I Been Pwned public breach catalogue (no key), downloaded once a day and matched locally.
# Shown as context ("this company had a breach"), never as a phishing signal. Data is CC BY 4.0.
HIBP_BREACHES_ENABLED=true
# HIBP requires a descriptive User-Agent on every request.
HIBP_USER_AGENT=PhishShield-AI/0.2 (browser security extension backend)

# --- AI (optional): page and message explanations ---
# AI_PROVIDER picks the provider: groq | anthropic | none. Leave empty to use whichever key is set (Groq first).
AI_PROVIDER=

# Groq (free tier works for demos): create a key at https://console.groq.com/keys
GROQ_API_KEY=
# Models with strict JSON-schema support: openai/gpt-oss-120b (default), openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-120b

# Anthropic Claude (optional alternative)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Anthropic only: server-side model fallback on overload ("default") or "off".
AI_FALLBACKS=default

# Timeouts in milliseconds.
INTEL_TIMEOUT_MS=4000
AI_TIMEOUT_MS=30000
