{
  "name": "phishshield-ai",
  "version": "0.2.0",
  "private": true,
  "description": "PhishShield AI - a Manifest V3 browser extension that detects phishing websites and scam indicators, with an optional minimal API for threat intelligence and AI analysis.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:ext": "node scripts/build.mjs --only=extension",
    "build:server": "node scripts/build.mjs --only=server",
    "server": "node --env-file-if-exists=.env dist/server/index.js",
    "dev:server": "npm run build:server && npm run server",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "jsqr": "1.4.0",
    "punycode": "^2.3.1",
    "tldts": "^7.4.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/punycode": "^2.1.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
